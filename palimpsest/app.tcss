Screen { background: #0a0a0a; color: #cfcfcf; }

BootScreen { align: center middle; }
#boot { width: auto; height: auto; color: #e8e8e8; text-align: left; }

#top { height: 5; padding: 0 1; border-bottom: solid #2c2c2c; }
#logo { width: 31; color: #f2f2f2; }
#meta-box { width: 1fr; padding: 0 2; }
#meta { height: 2; color: #9c9c9c; }
#ticker { height: 1; color: #3d3d3d; }
#sigil { width: 17; height: 4; color: #8a8a8a; content-align: right top; }

Tabs { height: 2; background: #0a0a0a; }
Tab { color: #6e6e6e; padding: 0 2; }
Tab.-active { color: #ffffff; text-style: bold; }
Tab:hover { color: #d0d0d0; }
Underline > .underline--bar { color: #f0f0f0; background: #222222; }

ContentSwitcher { height: 1fr; }
.view { height: 1fr; }

.oplist { width: 26; height: 1fr; background: #0a0a0a; border: none; border-right: solid #2c2c2c; padding: 0 1; }
OptionList > .option-list--option-highlighted { background: #2a2a2a; color: #ffffff; }
OptionList:focus > .option-list--option-highlighted { background: #e8e8e8; color: #0a0a0a; text-style: bold; }
OptionList > .option-list--option-hover { background: #1c1c1c; }

.work { width: 1fr; height: 1fr; padding: 0 2; }
.op-title { height: 1; color: #ffffff; text-style: bold; margin-top: 1; }
.op-about { height: 1; color: #808080; }
.fields { height: auto; max-height: 50%; margin-top: 1; }
.field-row { height: 1; margin-bottom: 1; }
.field-label { width: 30; height: 1; color: #8c8c8c; }
.field-row Input { width: 1fr; height: 1; border: none; padding: 0 1; background: #171717; color: #f0f0f0; }
.field-row Input:focus { background: #2a2a2a; border: none; }
.actions { height: 1; margin: 0 0 1 0; }
.hint { width: 1fr; height: 1; color: #5a5a5a; }
.scan { height: 1; color: #d8d8d8; }

RichLog { height: 1fr; background: #0d0d0d; color: #c8c8c8; border: solid #2c2c2c; padding: 0 1; scrollbar-size-vertical: 1; }
RichLog:focus { border: solid #8a8a8a; }

.decode-side { width: 26; height: 1fr; }
.pane-label { height: 1; color: #707070; margin-top: 1; }
TextArea { height: 1fr; background: #0d0d0d; color: #e0e0e0; border: solid #2c2c2c; padding: 0 1; }
TextArea:focus { border: solid #8a8a8a; }
#decode-key { height: 1; border: none; padding: 0 1; background: #171717; color: #f0f0f0; margin-bottom: 1; }
#decode-key:focus { background: #2a2a2a; border: none; }

DataTable { height: 1fr; background: #0a0a0a; color: #bdbdbd; }
DataTable > .datatable--header { background: #0a0a0a; color: #7a7a7a; text-style: bold; }
DataTable > .datatable--cursor { background: #e8e8e8; color: #0a0a0a; }
DataTable > .datatable--hover { background: #1c1c1c; }
#tools-note { height: 2; color: #707070; padding: 0 1; }

ModalScreen { align: center middle; background: #000000 70%; }
.modal { width: 76; height: auto; max-height: 85%; background: #101010; border: solid #cfcfcf; padding: 1 2; }
.modal-title { height: 1; color: #ffffff; text-style: bold; margin-bottom: 1; }
.modal Input { height: 1; border: none; padding: 0 1; background: #202020; color: #ffffff; margin-bottom: 1; }
.modal Input:focus { border: none; background: #303030; }
.modal DirectoryTree { height: 18; background: #0a0a0a; color: #b5b5b5; }
.modal-hint { height: 1; color: #6a6a6a; }

Footer { background: #0f0f0f; color: #777777; }
FooterKey { background: #0f0f0f; color: #777777; }
FooterKey .footer-key--key { background: #0f0f0f; color: #e4e4e4; }
FooterKey .footer-key--description { background: #0f0f0f; color: #777777; }

Screen { background: #0a0a0a; color: #cfcfcf; }

BootScreen { layout: vertical; }
#boot { width: 100%; height: 100%; }

#top { height: 6; padding: 0 1; border-bottom: solid #242424; }
#logo { width: 31; height: 3; color: #f2f2f2; margin-top: 1; }
#meta-box { width: 1fr; padding: 1 2 0 2; }
#meta { height: 2; color: #9c9c9c; }
#ticker { height: 1; }
#sigil { width: 17; height: 5; color: #8f8f8f; }

Tabs { height: 2; background: #0a0a0a; }
Tab { color: #666666; padding: 0 2; }
Tab.-active { color: #ffffff; text-style: bold; }
Tab:hover { color: #d0d0d0; }
Underline > .underline--bar { color: #f0f0f0; background: #1e1e1e; }

ContentSwitcher { height: 1fr; }
.view { height: 1fr; }

.oplist { width: 26; height: 1fr; background: #0a0a0a; border: none; border-right: solid #242424; padding: 0 1; scrollbar-size-vertical: 1; }
OptionList > .option-list--option-highlighted { background: #262626; color: #ffffff; }
OptionList:focus > .option-list--option-highlighted { background: #e8e8e8; color: #0a0a0a; text-style: bold; }
OptionList > .option-list--option-hover { background: #1a1a1a; }

.work { width: 1fr; height: 1fr; padding: 0 2; }
.op-title { height: 1; color: #ffffff; text-style: bold; margin-top: 1; }
.op-about { height: 1; color: #7c7c7c; }
.fields { height: auto; max-height: 14; margin-top: 1; scrollbar-size-vertical: 1; }
.fields:disabled { opacity: 100%; }
.field-row { height: 2; }
.field-label { width: 30; height: 1; color: #858585; }
.field-row:focus-within .field-label { color: #ffffff; }
.field-row Input { width: 1fr; height: 1; border: none; padding: 0 1; background: #161616; color: #f0f0f0; }
.field-row Input:focus { background: #2c2c2c; border: none; }
.actions { height: 1; margin: 0 0 1 0; }
.hint { width: 1fr; height: 1; color: #5c5c5c; }
.scan { height: 1; color: #dcdcdc; }

.idle { height: 1fr; min-height: 3; content-align: center middle; text-align: left; border: solid #1c1c1c; }
RichLog { display: none; height: 1fr; min-height: 3; background: #0d0d0d; color: #c8c8c8; border: solid #2c2c2c; padding: 0 1; scrollbar-size-vertical: 1; }
RichLog.shown { display: block; }
RichLog:focus { border: solid #8a8a8a; }
RichLog.flash { border: solid #ffffff; }

.pane-label { height: 1; color: #6e6e6e; margin-top: 1; }
TextArea { height: 1fr; min-height: 3; background: #0d0d0d; color: #e0e0e0; border: solid #2c2c2c; padding: 0 1; }
TextArea:focus { border: solid #8a8a8a; }
#decode-key-box { height: auto; display: none; }
#decode-key-box.shown { display: block; }
#decode-key { height: 1; border: none; padding: 0 1; background: #161616; color: #f0f0f0; }
#decode-key:focus { background: #2c2c2c; border: none; }

DataTable { height: 1fr; background: #0a0a0a; color: #bdbdbd; }
DataTable > .datatable--header { background: #0a0a0a; color: #767676; text-style: bold; }
DataTable > .datatable--cursor { background: #e8e8e8; color: #0a0a0a; }
DataTable > .datatable--hover { background: #1a1a1a; }
#tools-note { height: 2; color: #6e6e6e; padding: 0 1; }

ModalScreen { align: center middle; background: #000000 72%; }
.modal { width: 76; max-width: 94%; height: auto; max-height: 90%; background: #101010; border: solid #cfcfcf; padding: 1 2; }
.modal-title { height: 1; color: #ffffff; text-style: bold; margin-bottom: 1; }
.modal Input { height: 1; border: none; padding: 0 1; background: #202020; color: #ffffff; margin-bottom: 1; }
.modal Input:focus { border: none; background: #303030; }
.modal DirectoryTree { height: 16; background: #0a0a0a; color: #b5b5b5; }
.modal-hint { height: auto; color: #6a6a6a; }
#help-body { height: auto; color: #c8c8c8; }

Toast { background: #1a1a1a; color: #e8e8e8; border-left: outer #e8e8e8; }
Toast.-warning, Toast.-error, Toast.-information { background: #1a1a1a; border-left: outer #e8e8e8; }
Toast .toast--title { color: #ffffff; }

Footer { background: #0f0f0f; color: #777777; }
FooterKey { background: #0f0f0f; color: #777777; }
FooterKey .footer-key--key { background: #0f0f0f; color: #e4e4e4; }
FooterKey .footer-key--description { background: #0f0f0f; color: #777777; }

/* Responsive layouts, toggled from MainScreen.on_resize. */
.compact #top { height: 3; }
.compact #logo { height: 1; width: 21; margin-top: 0; text-style: bold; }
.compact #meta-box { padding: 0 1; }
.compact #ticker, .compact #sigil { display: none; }
.narrow .oplist { width: 21; }
.narrow .work { padding: 0 1; }
.narrow .field-label { width: 16; }
.narrow Tab { padding: 0 1; }
.short .op-title { margin-top: 0; }
.short .op-about { display: none; }
.short .fields { margin-top: 0; max-height: 7; }
.short .field-row { height: 1; }
.short .actions { margin: 0; }
.short .pane-label { margin-top: 0; }
